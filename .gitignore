# 数据集与运行输出体积较大，仅保留结构说明和训练配置。
/dataset/*
!/dataset/README.md
!/dataset/classroom_behavior.yaml
/outputs/*
!/outputs/README.md
/yolo26x-pose_openvino_model/
__pycache__/
*.pt
