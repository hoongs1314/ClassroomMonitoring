MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=classroom_monitoring
MYSQL_CHARSET=utf8mb4

# 也可以直接使用 DATABASE_URL 覆盖上面的 MySQL 分项配置。
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/classroom_monitoring?charset=utf8mb4

JWT_SECRET_KEY=please-change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=14
AUTO_CREATE_TABLES=false

ALIYUN_API_KEY=
