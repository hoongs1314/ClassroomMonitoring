# 复制为 deploy/.env.production 后，填写以下真实值。该文件不能提交到版本库。
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=classroom_monitoring
MYSQL_USER=classroom
MYSQL_PASSWORD=

# 使用至少 48 个随机字符的独立密钥。
JWT_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 不使用云端 VLM 时保持为空；使用前须确认课堂图像的授权与数据处理要求。
ALIYUN_API_KEY=
VLM_WORKER_COUNT=2

# HTTPS 反向代理部署时设为 true；若需要跨域前端，必须显式填写可信来源列表。
MEDIA_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# 对外只暴露前端端口；MySQL 与后端仅在 Docker 网络内通信。
FRONTEND_PORT=8080

# 运行资产目录。Windows 下可使用 ./inputs、./models、./outputs。
INPUTS_DIR=./inputs
MODELS_DIR=./models
OUTPUTS_DIR=./outputs
